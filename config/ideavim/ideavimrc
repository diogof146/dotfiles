" ============================================================
" mini_move.lua -> Move line/statement up/down, indent left/right
" ============================================================

nnoremap <A-j> <Action>(MoveLineDown)
nnoremap <A-k> <Action>(MoveLineUp)
vnoremap <A-j> <Action>(MoveStatementDown)
vnoremap <A-k> <Action>(MoveStatementUp)
nnoremap <A-h> <<
nnoremap <A-l> >>
vnoremap <A-h> <gv
vnoremap <A-l> >gv

" macOS: Option+letter types a character instead of sending Alt, so the <A-...> maps above
" never fire. These are the characters the Portuguese layout produces for Option+j/k/h/l.
nnoremap ¯ <Action>(MoveLineDown)
nnoremap „ <Action>(MoveLineUp)
vnoremap ¯ <Action>(MoveStatementDown)
vnoremap „ <Action>(MoveStatementUp)
nnoremap ˇ <<
nnoremap ‘ >>
vnoremap ˇ <gv
vnoremap ‘ >gv

" ============================================================
" window_manager.lua
" ============================================================

" The Project tree isn't a Vim window here, so <leader>wh focuses it directly
" (<C-w>h still moves between editor splits). Esc in the tree returns to the editor.
nnoremap <leader>wh <Action>(ActivateProjectToolWindow)
nnoremap <leader>wj <C-w>j
nnoremap <leader>wk <C-w>k
nnoremap <leader>wl <C-w>l
nnoremap <leader>wv <Action>(SplitVertically)
" (<leader>w= has no equivalent: IdeaVim doesn't support <C-w>=)
