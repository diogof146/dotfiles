" -- Leader keys
let mapleader = " "
let maplocalleader = ","

" -- Key ownership (Vim vs IDE) for keys the IDE also binds --
" Insert-mode Tab stays with the IDE so completion, live templates and Copilot accept still work
sethandler <Tab> n-v:vim i:ide
sethandler <S-Tab> n-v:vim i:ide
sethandler <C-r> a:vim
sethandler <C-h> a:vim

" -- IdeaVim built-in Vim-plugin emulations (bundled, no extra plugin) --
" Map exchange / replace-with-register to the substitute.nvim keys *before* enabling them,
" so they skip their default keys (cx/cxx/cxc and gr/grr), which would clash with c and gr
nmap sx <Plug>(Exchange)
nmap sxx <Plug>(ExchangeLine)
nmap sxc <Plug>(ExchangeClear)
xmap X <Plug>(Exchange)
nmap s <Plug>ReplaceWithRegisterOperator
nmap ss <Plug>ReplaceWithRegisterLine
nmap sS <Plug>ReplaceWithRegisterOperator$
xmap s <Plug>ReplaceWithRegisterVisual

set surround               " nvim-surround equivalent: ys/cs/ds work identically
set commentary              " gcc / gc{motion} commenting
set exchange                 " substitute.nvim's exchange (sx / sxx / sxc / X)
set ReplaceWithRegister      " substitute.nvim's substitute (s / ss / sS / visual s)
set argtextobj              " ia / aa text objects for function args
set NERDTree                " NERDTree-style keys inside the Project tool window
set highlightedyank          " flash yanked text (undo-glow equivalent)

" -- Core editor options (options.lua) --
set number
set relativenumber
set scrolloff=5
set incsearch
set hlsearch
set ideajoin                 " smarter J join using IDE's own logic
set clipboard+=unnamed
set clipboard+=ideaput
set idearefactormode=keep    " stay in the current mode after IDE refactorings (e.g. rename)

" ============================================================
" General keymaps
" ============================================================

" Indent/unindent selection, keep selection active
vnoremap <Tab> >gv
vnoremap <S-Tab> <gv

" Swap redo/undo-line
nnoremap U <C-r>
nnoremap <C-r> U

" Swap b/q (macro record vs. word-back)
nnoremap b q
nnoremap q b

" gg/G include start/end of line
nnoremap gg gg0
nnoremap G G$

" Global word-under-cursor replace with confirm — IdeaVim emulates :%s
" directly, so this is a literal port
nnoremap <leader>r :%s/\<<C-r><C-w>\>//gc<Left><Left><Left>

" Previous buffer
nnoremap <leader>b :bp<CR>

" Delete without yanking (blackhole register)
nnoremap d "_d
vnoremap d "_d
nnoremap D "_D
vnoremap D "_D
nnoremap x "_x
vnoremap x "_x
nnoremap S "_cc

" c = cut: delete into the clipboard without entering insert mode (autocmds.lua)
nnoremap c d
nnoremap cc dd
nnoremap C D
xnoremap c d

